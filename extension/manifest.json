{
  "manifest_version": 3,
  "name": "Easy Rental Search",
  "short_name": "Easy Rental",
  "version": "1.0.0",
  "description": "Found a rental on Airbnb or Vrbo? Find the same place on its own website and skip the booking fees.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Easy Rental Search",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.airbnb.com/*",
    "https://*.airbnb.ca/*",
    "https://*.airbnb.co.uk/*",
    "https://*.airbnb.com.au/*",
    "https://*.airbnb.ie/*",
    "https://*.airbnb.co.nz/*",
    "https://*.airbnb.de/*",
    "https://*.airbnb.fr/*",
    "https://*.airbnb.es/*",
    "https://*.airbnb.it/*",
    "https://*.airbnb.mx/*",
    "https://*.vrbo.com/*",
    "https://*.booking.com/*",
    "https://*.expedia.com/*",
    "https://*.hometogo.com/*",
    "https://*.evolve.com/*",
    "https://*.plumguide.com/*"
  ]
}
